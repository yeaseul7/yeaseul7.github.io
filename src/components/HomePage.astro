---
import { getCollection } from "astro:content";
import WritingActivity from "./WritingActivity.astro";

const posts = await getCollection("docs");
const datedPosts = posts
  .filter(({ id, data }) => !["index", "about", "roadmap"].includes(id)
    && !id.startsWith("secret/") && data.updatedAt);
const latestPosts = datedPosts
  .sort((a, b) => b.data.updatedAt!.getTime() - a.data.updatedAt!.getTime())
  .slice(0, 3);
---

<div class="home-page">
  <WritingActivity dates={datedPosts.map(({ data }) => data.updatedAt!)} />
  <section class="home-section" id="recent-posts" aria-labelledby="latest-title">
    <h1 id="latest-title">recent</h1>
    <div class="post-list">
      {latestPosts.map(({ id, data }) => (
        <article class="post-entry">
          <a href={`/${id}/`}>
            <h2>{data.title}</h2>
            <p>{data.description}</p>
          </a>
          <time datetime={data.updatedAt!.toISOString()}>
            {data.updatedAt!.toLocaleDateString("ko-KR", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" })}
          </time>
        </article>
      ))}
    </div>
  </section>
</div>
