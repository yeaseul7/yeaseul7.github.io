---
import { createHash } from 'node:crypto';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { validateExam } from '../../utils/exam.mjs';

const exams = Object.entries(import.meta.glob('../../data/exams/*.json', { eager: true, import: 'default' }))
  .map(([path, data]) => {
    const slug = path.split('/').pop()!.replace(/\.json$/, '');
    const exam = validateExam(data);
    const revision = createHash('sha256').update(JSON.stringify(exam)).digest('hex').slice(0, 16);
    return { slug, exam, storageKey: `study-exam:${slug}:${revision}` };
  });
---

<StarlightPage frontmatter={{ title: '복습 시험', description: '공부한 내용을 직접 풀고 채점하는 복습 시험입니다.', tableOfContents: false }}>
  <div class="exam-list">
    {exams.map(({ slug, exam, storageKey }) => (
      <article class="exam-card" data-exam-card data-storage-key={storageKey} data-answer-key={JSON.stringify(exam.questions.map(({ answer }) => answer))} aria-labelledby={`exam-${slug}`}>
        <header>
          <p class="exam-meta">{exam.questions.length}문항 · 객관식</p>
          <h2 id={`exam-${slug}`}><a href={`/exams/${slug}/`}>{exam.title}</a></h2>
        </header>
        <div class="exam-score">
          <div>
            <span class="score-label">점수</span>
            <p><strong data-card-score>—</strong><span class="score-unit" data-card-unit hidden>점</span></p>
          </div>
          <span class="exam-state" data-card-state>미응시</span>
        </div>
        <p class="exam-detail" data-card-detail>아직 풀이 기록이 없습니다.</p>
        <footer>
          <a class="exam-start" data-card-action href={`/exams/${slug}/`}>시험 시작</a>
          <a class="exam-pdf" href={`/exams/${slug}/questions.pdf`} download>문제지 PDF</a>
        </footer>
      </article>
    ))}
    {!exams.length && <p class="empty-exams">아직 등록된 시험이 없습니다.</p>}
  </div>
  {exams.length > 0 && <p class="storage-note">점수와 풀이 기록은 현재 브라우저 기준입니다.</p>}
</StarlightPage>

<script>
  import { gradeExam, restoreAttempt } from '../../utils/exam.mjs';

  const updateCards = () => {
    for (const card of document.querySelectorAll<HTMLElement>('[data-exam-card]')) {
      const answers: number[] = JSON.parse(card.dataset.answerKey!);
      const exam = { questions: answers.map((answer) => ({ answer })) };
      const score = card.querySelector<HTMLElement>('[data-card-score]')!;
      const unit = card.querySelector<HTMLElement>('[data-card-unit]')!;
      const stateLabel = card.querySelector<HTMLElement>('[data-card-state]')!;
      const detail = card.querySelector<HTMLElement>('[data-card-detail]')!;
      const action = card.querySelector<HTMLElement>('[data-card-action]')!;
      let raw = null;
      try { raw = localStorage.getItem(card.dataset.storageKey!); }
      catch {
        score.textContent = '—';
        unit.hidden = true;
        stateLabel.textContent = '기록 확인 불가';
        detail.textContent = '브라우저에서 저장된 기록을 읽을 수 없습니다.';
        action.textContent = '시험 풀기';
        continue;
      }
      const attempt = restoreAttempt(exam, raw);
      const graded = gradeExam(exam, attempt.answers);
      const completed = attempt.graded && graded.answered > 0;
      score.textContent = completed ? String(Math.round(graded.correct / graded.total * 100)) : '—';
      unit.hidden = !completed;
      stateLabel.textContent = completed ? '채점 완료' : graded.answered ? '풀이 중' : '미응시';
      detail.textContent = completed ? `${graded.correct} / ${graded.total}문항 정답`
        : graded.answered ? `${graded.answered} / ${graded.total}문항 풀이` : '아직 풀이 기록이 없습니다.';
      action.textContent = completed ? '결과 보기' : graded.answered ? '이어 풀기' : '시험 시작';
    }
  };

  updateCards();
  window.addEventListener('pageshow', updateCards);
  window.addEventListener('storage', updateCards);
</script>

<style>
  .exam-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    margin: 0 0 1rem;
    font-size: 1rem;
    line-height: 1.5;
  }

  .exam-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    margin: 0;
    padding: 1.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
    background: var(--sl-color-bg);
  }

  .exam-card :is(p, h2, header, footer) {
    margin: 0;
  }

  .exam-card header {
    min-height: 7rem;
  }

  .exam-card .exam-meta {
    margin-bottom: 0.75rem;
    color: var(--sl-color-gray-2);
    font-size: 0.75rem;
  }

  .exam-card h2 {
    font-size: 1.125rem;
    line-height: 1.5;
    word-break: keep-all;
    overflow-wrap: anywhere;
  }

  .exam-card h2 a {
    color: var(--sl-color-text);
    text-decoration: none;
  }

  .exam-card h2 a:hover {
    text-decoration: underline;
  }

  .exam-score {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--blog-border);
  }

  .score-label,
  .exam-state,
  .exam-card .exam-detail {
    color: var(--sl-color-gray-2);
    font-size: 0.75rem;
  }

  .exam-score strong {
    font-size: 2.5rem;
    font-weight: 650;
    line-height: 1.3;
    font-variant-numeric: tabular-nums;
  }

  .score-unit {
    margin-inline-start: 0.3rem;
    font-size: 0.85rem;
  }

  .exam-card .exam-detail {
    margin-top: 0.5rem;
  }

  .exam-card footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1.75rem;
    font-size: 0.8rem;
  }

  .exam-card .exam-start {
    padding: 0.6rem 0.85rem;
    color: var(--sl-color-bg);
    background: var(--sl-color-text);
    border-radius: 4px;
    text-decoration: none;
  }

  .exam-start:hover {
    opacity: 0.8;
  }

  .exam-pdf {
    color: var(--sl-color-gray-2);
  }

  .exam-card a:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 4px;
  }

  .storage-note {
    color: var(--sl-color-gray-2);
    font-size: 0.75rem;
  }

  .empty-exams {
    grid-column: 1 / -1;
  }

  @media (max-width: 40rem) {
    .exam-list { grid-template-columns: 1fr; }
    .exam-card header { min-height: auto; }
  }
</style>
